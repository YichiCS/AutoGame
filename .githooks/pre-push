#!/bin/sh
# AutoGame 更新规则：main 只接受「合并分支」带来的改动。
# 推送 main 时，检查新推上去的 main 主线（first-parent）上是否都是合并提交；
# 直接在 main 上做的提交、或者快进合并（git merge 没加 --no-ff）都会被拦下。
# 启用：在仓库根目录运行一次  git config core.hooksPath .githooks

zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  [ "$local_sha" = "$zero" ] && continue                         # 删除远端分支
  [ "$remote_sha" = "$zero" ] && continue                        # 远端还没有 main
  git cat-file -e "$remote_sha" 2>/dev/null || continue          # 本地没有远端的最新提交，先 git pull
  direct=$(git rev-list --first-parent --no-merges "$remote_sha..$local_sha")
  if [ -n "$direct" ]; then
    echo "✗ 这些提交没有经过「分支 → 合并」就要进 main：" >&2
    git log --oneline --first-parent --no-merges "$remote_sha..$local_sha" >&2
    echo "  规则：在 <游戏id>-v<版本号> 分支上修改，再用 git merge --no-ff <分支名> 合并回 main。" >&2
    echo "  补救：git branch <游戏id>-v<版本号> && git reset --hard origin/main，然后重新 --no-ff 合并。" >&2
    status=1
  fi
done
exit $status
