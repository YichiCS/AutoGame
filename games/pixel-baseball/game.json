{
  "id": "pixel-baseball",
  "name": "像素甲子园",
  "subtitle": "监督之路",
  "version": "2.1.0",
  "legacyVersions": { "0.1.0": "1.0.0", "1.0.0": "2.0.0", "2.0.0": "2.1.0" },
  "description": "以日本高中棒球为题材的像素风棒球：平时球队按方针自己训练、成长；比赛由你以打席为单位亲自指挥——进攻从打者身后看、防守从投手身后看，下达打法、狙球、跑垒、配球等指令，对手会根据之前的打席调整策略。能力 0-100、21 种变化球、自定义阵容、90 多种事件。",
  "tags": ["棒球", "指挥", "经营模拟"],
  "entry": "dist/index.html",
  "cover": "docs/screenshot.png",
  "color": "#38b764",
  "source": "https://github.com/YichiCS/Pixel-Baseball",
  "build": {
    "command": "npm ci && npm run typecheck && npm run build",
    "outputs": ["dist/index.html"]
  },
  "saves": {
    "localStorage": ["pixel-baseball:*", "pixel-koshien:*"],
    "indexedDB": ["pixel-koshien"],
    "adapter": "save-adapter.js",
    "inGameExport": {
      "match": ["game", "mgr", "roster", "tours"],
      "hint": "游戏右上角「⚙ 设置 → 导入存档」"
    }
  },
  "dock": {
    "y": 0.42
  }
}
