{
  "id": "pixel-baseball",
  "name": "像素甲子园",
  "subtitle": "监督之路",
  "version": "1.0.0",
  "description": "以日本高中棒球为题材的像素风挂机经营：球队按你的方针自动训练、自动比赛，你只需定方针、修设施、在关键时刻拿主意。15 项能力、21 种变化球、魔球与 90 多种事件，目标是站上甲子园。",
  "tags": ["挂机", "经营模拟", "体育"],
  "entry": "dist/index.html",
  "cover": "docs/screenshot.png",
  "color": "#38b764",
  "source": "https://github.com/YichiCS/Pixel-Baseball",
  "build": {
    "command": "npm ci && npm run typecheck && npm run build",
    "outputs": ["dist/index.html"]
  },
  "saves": {
    "localStorage": ["pixel-baseball:*", "pixel-koshien:*"],
    "indexedDB": ["pixel-koshien"],
    "adapter": "save-adapter.js",
    "inGameExport": {
      "match": ["game", "mgr", "roster", "tours"],
      "hint": "游戏右上角「⚙ 设置 → 导入存档」"
    }
  },
  "dock": { "y": 0.42 }
}
